# ────────────────────────────────────────────────
# Psychology RAG Assistant — Environment Variables
# Copy this file to .env and fill in values for local overrides.
# Docker Compose can run without a custom .env because compose defaults
# are defined in compose.yaml; this file is still the single place
# to override those defaults intentionally.
# ────────────────────────────────────────────────

# App
APP_NAME=Calma
DEPLOYMENT_MODE=local
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
RETRIEVAL_BACKEND=faiss
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=calma_chunks
ENABLE_GRAPH_RAG=false
GRAPH_RAG_MIN_CHUNKS=400
GRAPH_RAG_MIN_QUERY_TERMS=5
ROLLOUT_MODE=stable
ROLLOUT_TRAFFIC_PERCENT=0
ENABLE_QDRANT_FALLBACK=true
ENABLE_OLLAMA_FALLBACK=true
MODEL_CONTRACT_VERSION=v1
SENSITIVE_LOG_REDACTION_ENABLED=true
ENABLE_RERANKER=true
RERANK_TOP_K=3
RERANK_MAX_CHARS=1200
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
VITE_API_URL=/api
FRONTEND_API_UPSTREAM=backend:8000

# Ollama (local LLM)
# Local Python runs use localhost. Docker Compose overrides this to
# http://host.docker.internal:11434 unless you set a different value.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest

# Retrieval
TOP_K=5

# Evidence gate (cosine similarity thresholds)
EVIDENCE_MIN_SCORE=0.22
EVIDENCE_MIN_CHUNKS=1

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Demo retention defaults
RAW_CHAT_RETENTION_DAYS=90
SESSION_SUMMARY_RETENTION_DAYS=365
SCREENING_RETENTION_DAYS=365
CONSENT_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=365

# Streamlit
STREAMLIT_SERVER_PORT=8501
